# Environment file for user defined variables in docker-compose.yml

# ACCEPT_EULA: Pass 'Y' to accept license terms for the shared SQL Server Linux
# container and the Azure Service Bus emulator.
# Service Bus emulator EULA : https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
# SQL Server Linux EULA : https://go.microsoft.com/fwlink/?LinkId=746388
ACCEPT_EULA="Y"

# Used only in local dev - SA password for the shared SQL Server container.
# This same password is also used by the Service Bus emulator because it reuses
# the existing mssql service instead of running a second SQL container.
MSSQL_SA_PASSWORD="P@ssword123!"

# OpenTelemetry API Key
SEQ_FIRSTRUN_NOAUTHENTICATION="TRUE"
# Used only in local dev - Seq API Key
SEQ_STORAGE_SECRETKEY="XsL3FMvDWrPVqiIkzSkKEojF/Z/OpDJV4FkRNje0G4s="

# Host port mappings for local container services.
# These values control the host-side ports published by docker compose.
# Format: <SERVICE>_<PURPOSE>_PORT="<host-port>"

# SQL Server
MSSQL_PORT="10433"

# Cosmos DB emulator
COSMOSDB_HTTPS_PORT="10081"
COSMOSDB_EXPLORER_PORT="10181"

# Redis
REDIS_PORT="10120"

# RedisInsight
REDISINSIGHT_WEB_PORT="10121"

# SMTP4Dev
SMTP4DEV_SMTP_PORT="10130"
SMTP4DEV_POP_PORT="10131"
SMTP4DEV_IMAP_PORT="10132"
SMTP4DEV_WEB_PORT="10140"

# Seq
SEQ_HTTP_PORT="10150"

# WireMock
WIREMOCK_HTTP_PORT="10080"
WIREMOCK_HTTPS_PORT="10443"

# Azurite
AZURITE_BLOB_PORT="10000"
AZURITE_QUEUE_PORT="10001"
AZURITE_TABLE_PORT="10002"

# Service Bus emulator
SERVICEBUS_AMQP_PORT="10170"
SERVICEBUS_ADMIN_PORT="10171"

# WireMock HTTPS keystore password (generate keystore with ./certs/Generate-WireMockCert.ps1 from containers/ or ./containers/certs/Generate-WireMockCert.ps1 from repo root)
WIREMOCK_KEYSTORE_PASSWORD="changeit"

# Optional: absolute path to the WireMock CA certificate for Node TLS (leave empty if not needed).
# The docker_setup scripts will automatically populate this with the correct path.
# Example: /absolute/path/to/your/Developer-Toolbox/containers/certs/wiremock.crt
NODE_EXTRA_CA_CERTS=""
