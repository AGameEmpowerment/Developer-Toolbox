# Environment file for user defined variables in docker-compose.yml
# docker_setup replaces managed "auto" passwords/keys with cryptographically random
# values in the ignored .env file. Existing explicit developer values are preserved.
# Use docker_setup to start services; this template is also used for config/build checks.

# ACCEPT_EULA: Pass 'Y' to accept license terms for the shared SQL Server Linux
# container and the Azure Service Bus emulator.
# Service Bus emulator EULA : https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
# SQL Server Linux EULA : https://go.microsoft.com/fwlink/?LinkId=746388
ACCEPT_EULA="Y"

# Used only in local dev - SA password for the shared SQL Server container.
# This same password is also used by the Service Bus emulator because it reuses
# the existing mssql service instead of running a second SQL container.
MSSQL_SA_PASSWORD="auto"

# Used only in local dev - PostgreSQL initialization values.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="auto"
POSTGRES_DB="ProjectExample"

# OpenTelemetry API Key
SEQ_FIRSTRUN_NOAUTHENTICATION="TRUE"
# Used only in local dev - Seq API Key
SEQ_STORAGE_SECRETKEY="auto"

# WireMock HTTPS keystore password (generate keystore with ./certs/Generate-WireMockCert.ps1 from containers/ or ./containers/certs/Generate-WireMockCert.ps1 from repo root)
WIREMOCK_KEYSTORE_PASSWORD="auto"

# Optional: absolute path to the WireMock CA certificate for Node TLS (leave empty if not needed).
# The docker_setup scripts will automatically populate this with the correct path.
# Example: /absolute/path/to/your/Developer-Toolbox/containers/certs/wiremock.crt
NODE_EXTRA_CA_CERTS=""

# Local development messaging and AWS emulation resources.
RABBITMQ_DEFAULT_USER="toolbox"
RABBITMQ_DEFAULT_PASS="auto"
RABBITMQ_HOST="localhost"
RABBITMQ_PORT="10190"

# Moto is a free Apache-2.0 AWS emulator; it needs no account, license, or engine socket.
# Examples: shared host-side configuration for the CLI, Azure Functions, and Lambda.
# These values target the local toolbox only. Database samples create ToolboxSamples.
# Keep credential references double-quoted so Docker Compose expands the values above.
ConnectionStrings__SqlServer="Server=127.0.0.1,10433;Database=ToolboxSamples;User ID=sa;Password=${MSSQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True"
ConnectionStrings__Postgres="Host=localhost;Port=10432;Database=ToolboxSamples;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
ServiceBusConnection="Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
AzureWebJobsStorage="UseDevelopmentStorage=true"
ToolboxAzureStorage="UseDevelopmentStorage=true"
# Public Azurite development account key; explicit endpoints work in every language.
Resources__AzureStorage__ConnectionString="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;QueueEndpoint=http://localhost:10001/devstoreaccount1;TableEndpoint=http://localhost:10002/devstoreaccount1;"

Resources__Cosmos__Endpoint="https://localhost:10081"
# Public development emulator key documented by Microsoft; never use a cloud account key here.
Resources__Cosmos__Key="C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw=="
Resources__Cosmos__AllowUntrustedLocalCertificate="true"
Resources__DynamoDb__Endpoint="http://localhost:10180"
Resources__Redis__ConnectionString="localhost:10120"
Resources__Mail__Host="localhost"
Resources__Mail__Port="10130"
Resources__Seq__Endpoint="http://localhost:10150"
# Leave empty while Seq has local authentication disabled; use a Seq API key if enabled.
Resources__Seq__ApiKey=""
Resources__WireMock__Endpoint="http://localhost:10080"

TOOLBOX_AWS_ENDPOINT="http://localhost:10195"
Resources__S3__Endpoint="${TOOLBOX_AWS_ENDPOINT}"
Resources__S3__Bucket="toolbox-samples"
# Dummy credentials for DynamoDB Local and Moto, never a real AWS account.
Resources__AWS__AccessKey="test"
Resources__AWS__SecretKey="test"

# Resource initializer uses the internal Compose network; examples use host endpoints.
TOOLBOX_CONTAINER_AWS_ENDPOINT="http://aws-emulator:5000"

# Java transactional examples use Hibernate and a separate ToolboxJavaSamples database.
# Host-side Java CLI and local Functions values.
JAVA_SQLSERVER_HOST="127.0.0.1"
JAVA_SQLSERVER_PORT="10433"
JAVA_SQLSERVER_USER="sa"
JAVA_POSTGRES_HOST="localhost"
JAVA_POSTGRES_PORT="10432"
