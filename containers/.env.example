# Environment file for user defined variables in docker-compose.yml

# ACCEPT_EULA: Pass 'Y' to accept license terms for Azure SQL Edge and Azure Service Bus emulator.
# Service Bus emulator EULA : https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
# SQL Edge EULA : https://go.microsoft.com/fwlink/?linkid=2139274
ACCEPT_EULA="Y"

# Used only in local dev - SQL Server Password
MSSQL_SA_PASSWORD="P@ssword123!"

# OpenTelemetry API Key
SEQ_FIRSTRUN_NOAUTHENTICATION="TRUE"
# Used only in local dev - Seq API Key
SEQ_STORAGE_SECRETKEY="XsL3FMvDWrPVqiIkzSkKEojF/Z/OpDJV4FkRNje0G4s="

# WireMock HTTPS keystore password (generate keystore with ./certs/Generate-WireMockCert.ps1)
WIREMOCK_KEYSTORE_PASSWORD="changeit"

# Optional host port overrides (use if ports are reserved/in use on your machine)
SMTP4DEV_SMTP_PORT="10130"
SMTP4DEV_POP_PORT="10131"
SMTP4DEV_IMAP_PORT="10132"
SMTP4DEV_WEB_PORT="10140"
SEQ_HTTP_PORT="10150"
SERVICEBUS_AMQP_PORT="10170"
SERVICEBUS_HTTP_PORT="10171"

# Ollama service
OLLAMA_API_KEY="1234567890"
OLLAMA_MODEL="llama3"
