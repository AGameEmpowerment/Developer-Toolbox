#!/usr/bin/env bash
set -euo pipefail

# Installer template: install_toolbox_setup.sh copies this file to the consumer
# repository root as setup_toolbox.sh. The installed Toolbox launcher owns all
# clone, update, and setup behavior; this template is not run from this folder.
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
exec bash "${SCRIPT_DIR}/setup/_toolbox.sh" "$@"

