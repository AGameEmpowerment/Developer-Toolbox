# Docker Desktop production-style deployment settings for:
#   docker compose --env-file devops/docker/systemuptimetracker.production.env -f devops/docker/docker-compose.yml up -d
#
# Copy this file to:
#   devops/docker/systemuptimetracker.production.env
# and replace placeholder values before running Deploy-SystemUptimeTrackerDocker.ps1.
# Build-SystemUptimeTrackerDockerImages.ps1 and Deploy-SystemUptimeTrackerDocker.ps1
# auto-generate local values for
# UI_AUTH_COOKIE_SECRET, UI_IMPERSONATE_ENCRYPTION_KEY, and API_REDACTION_KEY
# when they create or repair the env file.
# The generated devops/docker/systemuptimetracker.production.env file is ignored by git.
#
# SQL Server is owned by this standalone production-style stack. It does not
# use the development SQL instance or dev_common_shared_mssql-data volume.

SYSTEMUPTIMETRACKER_IMAGE_TAG=latest
SYSTEMUPTIMETRACKER_NETWORK_NAME=systemuptimetracker
SYSTEMUPTIMETRACKER_SQL_VOLUME_NAME=systemuptimetracker-production-sql-data
SYSTEMUPTIMETRACKER_SQL_BACKUP_VOLUME_NAME=systemuptimetracker-production-sql-backups

# Standalone SystemUptimeTracker SQL Server
# The deployment helper generates a strong local password when it creates or
# upgrades the ignored environment file. Use a secret store in a real environment.
SYSTEMUPTIMETRACKER_SQL_SA_PASSWORD=replace_with_strong_sql_password
SYSTEMUPTIMETRACKER_SQL_APP_USERNAME=systemuptimetracker
SYSTEMUPTIMETRACKER_SQL_APP_PASSWORD=replace_with_strong_application_password
# Express is production-licensed but resource limited. Set Standard or
# Enterprise only when the deployment has the corresponding SQL Server license.
SYSTEMUPTIMETRACKER_SQL_EDITION=Express
SYSTEMUPTIMETRACKER_SQL_BIND_HOST=127.0.0.1
SYSTEMUPTIMETRACKER_SQL_PUBLIC_PORT=11433

# Host bind controls for published ports.
# Keep the UI public by default and the debug API loopback-only unless you need remote access.
UI_BIND_HOST=0.0.0.0
# Public UI port on the host. The API stays internal-only.
UI_PUBLIC_PORT=8001
UI_APP_BASE_URL=http://localhost:8001
# Used only when Deploy-SystemUptimeTrackerDocker.ps1 is invoked with -DebugAccess.
API_BIND_HOST=127.0.0.1
API_PUBLIC_PORT=8002

# UI session/auth settings
UI_AUTH_COOKIE_SECRET=replace_with_64_character_hex_secret
UI_CONSOLE_ACCESSTOKEN=false
IMPERSONATING_COOKIE=acting-as
UI_IMPERSONATE_ENCRYPTION_KEY=replace_with_64_character_hex_key

# UI application metadata and diagnostics
UI_APP_LOGGING_LEVEL=Information
UI_APP_VERSION=0.1.0-docker
UI_APP_NAME=SystemUptimeTracker
UI_APP_INSIGHTS_ENABLED=false
UI_APP_INSIGHTS_KEY=
UI_APP_INSIGHTS_CLOUD_ROLE=systemuptimetracker-web
UI_APP_OPENTELEMETRY_ENABLED=false
UI_APP_OPENTELEMETRY_SEQ_ENABLED=false
UI_APP_OPENTELEMETRY_ASPIRE_ENABLED=false
UI_APP_OPENTELEMETRY_SEQ_ENDPOINT=http://host.docker.internal:10150/ingest/otlp/v1/logs
# Default local Docker OpenTelemetry target is the shared Seq/OtelCollector.
# Replace for deployment with the destination OTLP endpoint and API key.
# Required only when UI Seq OpenTelemetry export is enabled.
UI_APP_OPENTELEMETRY_SEQ_API_KEY=replace_with_seq_api_key
UI_APP_OPENTELEMETRY_ASPIRE_ENDPOINT=
UI_OTEL_EXPORTER_OTLP_ENDPOINT=
UI_OTEL_SERVICE_NAME=systemuptimetracker-web
UI_OTEL_RESOURCE_ATTRIBUTES=

# Optional Microsoft identity settings for the UI.
# Leave blank when using only local SystemUptimeTracker identity.
UI_MICROSOFT_CLIENT_ID=
UI_MICROSOFT_CLIENT_SECRET=
UI_MICROSOFT_TENANT_ID=
UI_MICROSOFT_AUTHORITY=
UI_MICROSOFT_API_SCOPE=
UI_MICROSOFT_AUTH_SCOPES=
UI_MICROSOFT_REDIRECT_PATH=/auth/callback
UI_MICROSOFT_POST_LOGOUT_REDIRECT_URI=

# API application settings
API_ALLOWED_HOSTS=*
API_REDACTION_KEY=replace_with_two_braced_guid_values
API_KEYVAULT_URI=
# The API connection string is assembled inside Compose from the standalone SQL
# service name and SYSTEMUPTIMETRACKER_SQL_SA_PASSWORD.
# On each deployment, EF Core applies only pending idempotent migrations before
# the API accepts traffic. Set false only when migrations are applied separately.
API_APPLY_STARTUP_MIGRATIONS=true
API_APPLICATIONINSIGHTS_CONNECTION_STRING=na

# API feature flags
API_FEATURE_ASPIRE_ENABLED=false
API_FEATURE_CONFIGURATIONINFO_ENABLED=false
API_FEATURE_INFOENDPOINT_ENABLED=false
API_FEATURE_OPENAPI_ENABLED=false
API_FEATURE_OPENTELEMETRY_ENABLED=false
API_FEATURE_OPENTELEMETRY_SEQ_ENABLED=false

# API OpenTelemetry
API_OPENTELEMETRY_ENDPOINT=http://host.docker.internal:10150/ingest/otlp/v1/logs
# Required only when API OpenTelemetry export is enabled.
API_OPENTELEMETRY_APIKEY=replace_with_seq_api_key
API_OPENTELEMETRY_EXPORTDEBUGLOGS=false
API_OPENTELEMETRY_INCLUDESCOPES=false
API_OPENTELEMETRY_INCLUDEFORMATTEDMESSAGE=false
API_OPENTELEMETRY_PARSESTATEVALUES=false

# API local JWT validation (optional)
API_AUTH_JWT_ENABLED=false
API_AUTH_JWT_ISSUER=SystemUptimeTracker
API_AUTH_JWT_AUDIENCE=SystemUptimeTracker.Api
# Required when API_AUTH_JWT_ENABLED=true. Supply at least 32 random characters through the deployment secret store.
API_AUTH_JWT_SIGNINGKEY=replace_with_local_jwt_signing_key
API_AUTH_JWT_CLOCKSKEW_SECONDS=60
API_AUTH_LOGIN_MINUTES=20

# API HTTP resilience
API_HTTP_RESILIENCE_TIMEOUT_SECONDS=120

# API cache
API_REDIS_LOCALOVERRIDE=false
API_REDIS_INSTANCENAME=SystemUptimeTracker_docker
API_REDIS_URL=host.docker.internal:10120
API_REDIS_CACHE_MINUTES=120
API_CACHE_HEALTH_INTERVAL_SECONDS=5
