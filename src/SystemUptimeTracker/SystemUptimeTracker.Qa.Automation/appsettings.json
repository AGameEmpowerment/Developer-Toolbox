{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Playwright": "Warning"
    }
  },
  "FeatureManagement": {
    "OpenTelemetrySeqEnabled": true,
    "AspireEnabled": true
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:10150/ingest/otlp/v1/logs",
    "ApiKey": ""
  },
  "ConnectionStrings": {
    "SharedQaDatabase": "__SET_IN_USER_SECRETS_OR_ENV__",
    "DefaultConnection": "Replace-Key-From-Secrets.json"
  },
  "QaAutomation": {
    "UseExternalHost": false,
    "SkipIdentityCleanup": false,
    "AllowMainDatabase": false,
    "WebBaseUrl": "http://localhost:8001"
  },
  "AppSettings": {
    "Environment": "Development",
    "CryptographicSalt": "{8027C049-B4B0-412E-9FC5-E3414FE28D08}",
    "AzureKeyVaultUri": "",
    "AzureVaultKeys": [],
    "Credentials": {
      "Username": "__SET_IN_USER_SECRETS_OR_ENV__",
      "Password": "__SET_IN_USER_SECRETS_OR_ENV__"
    },
    "BaseUrl": "https://localhost:7060/",
    "BaseRoute": "",
    "HttpCustomHeaders": {},
    "WebBrowserConfiguration": {
      "PageLoadTimeoutInSeconds": 120,
      "ImplicitWaitInSeconds": 10,
      "JavascriptTimeoutInSeconds": 30,
      "TimeoutCommandSecs": 60,
      "BrowserType": "Chromium",
      "HeadlessBrowser": true
    },
    "ApiClientConfiguration": {
      "AllowLoopbackCertificateBypass": true,
      "TcpTimeoutInSeconds": 120,
      "RetryLimit": 2
    }
  },
  "TestConfiguration": {
    "WebValidation": {
      "BaseUrl": "https://localhost:3001",
      "UseInternalPages": true,
      "Pages": {
        "Home": "/",
        "Login": "/auth/login"
      },
      "Titles": {
        "Home": "System Uptime Tracker",
        "Login": "Sign In"
      }
    }
  }
}
