{
  "AppHost": {
    "Server": {
      "Name": "systemuptimetracker-api",
      "ProjectPath": "../SystemUptimeTracker.Api/SystemUptimeTracker.Api.csproj",
      "LaunchProfileName": "aspire-https",
      "Port": 7060,
      "HealthCheckPath": "/_health",
      "EnvironmentVariables": {
        "FeatureManagement__AspireEnabled": "true",
        "ConnectionStrings__DefaultConnection": "__SET_IN_USER_SECRETS_OR_ENV__"
      }
    },
    "Client": {
      "Name": "systemuptimetracker-web",
      "AppDirectory": "../SystemUptimeTracker.Web",
      "RunScriptName": "dev",
      "Port": 3001,
      "PortEnvironmentVariable": "PORT",
      "IsProxied": false,
      "EnvironmentVariables": {
        "API_BASE_URL": "https://localhost:7060/",
        "APP_BASE_URL": "https://localhost:3001/",
        "APP_OPEN_TELEMETRY_ENABLED": "true",
        "APP_OPEN_TELEMETRY_ASPIRE_ENABLED": "true",
        "APP_OPEN_TELEMETRY_SEQ_ENABLED": "true",
        "APP_OPEN_TELEMETRY_SEQ_ENDPOINT": "http://localhost:10150/ingest/otlp",
        "NEXT_ALLOWED_DEV_ORIGINS": "host.docker.internal,host.docker.internal:3001,localhost,localhost:3001,127.0.0.1,127.0.0.1:3001"
      }
    }
  }
}
