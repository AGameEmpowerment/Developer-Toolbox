{
  /*
  * See the CONTRIBUTING.md file for information on how to set up your local development environment.
  *
  * To use the Visual Studio build profiles, install the Visual Studio Extension "SlowCheetah"
  * Additionally to change build environment update to use the "CentralApi.Web (Build Config)" from drop down.
  *
  * Keyvault variable name is separated with "--". Example: ConnectionStrings--DefaultConnection
  *
  * When mapping Environment variables to appsettings.json, use the following format: ConnectionStrings__DefaultConnection where the "__" is treated similarly to the "--" in the keyvault.
  * This will map the environment variable ConnectionStrings__DefaultConnection to the DefaultConnection key in appsettings.json
  */
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },

  "AllowedHosts": "*",
  "ImpersonatingCookie": "acting-as",
  "RedactionKey": "Replace-Key-From-Secrets.json",
  "KeyVaultUri": "Replace-Key-From-Secrets.json",

  // All application enable/disable flags must live in FeatureManagement.
  // These flags use Microsoft.FeatureManagement.
  "FeatureManagement": {
    "AspireEnabled": false,
    "ConfigurationInfoEnabled": false,
    "InfoEndpointEnabled": false,
    "OpenApiEnabled": false,
    // OpenTelemetry is on by default; specific sinks remain independently toggleable.
    "OpenTelemetryEnabled": true,
    // Developer-only local sink for diagnostics and validation.
    "OpenTelemetrySeqEnabled": false,
    "SqlDebugger":  false
  },

  "ForwardedHeaders": {
    // Populate these lists in proxy-terminated environments so ASP.NET only trusts X-Forwarded-* values from known infrastructure.
    "KnownIPNetworks": [],
    "KnownProxies": []
  },

  "Cors": {
      // Keep shared defaults empty so non-development deployments must opt in explicitly.
      "AllowedOrigins": []
  },

  "Cache": {
    "HealthMonitor": {
      "IntervalSeconds": 5
    }
  },

  "OpenTelemetry": {
    // Default Open Telemetry Local Development for Seq. Replace on deployment with App Insights
    "Endpoint": "http://localhost:10150/ingest/otlp/v1/logs",
    "ApiKey": "Replace-Key-From-Secrets.json",
    "ExportDebugLogs": true,
    "IncludeScopes": true,
    "IncludeFormattedMessage": true,
    "ParseStateValues": true
  },

  // Optionally, include Azure Application Insights connection string
  "ConnectionStrings": {
    "DefaultConnection": "Replace-Key-From-Secrets.json",
    "ApplicationInsights": "Replace-Key-From-Secrets.json"
  },

  "DataProtection": {
    "ApplicationName": "SystemUptimeTracker",
    "KeyRingPath": "",
    "ProtectKeysWithDpapi": true
  },

  "Auth": {
    "Jwt": {
      "Enabled": false,
      "Issuer": "SystemUptimeTracker",
      "Audience": "SystemUptimeTracker.Api",
      "SigningKey": "__SET_IN_USER_SECRETS_OR_ENV__",
      "ClockSkewSeconds": 60
    },
    "LoginTimeInMinutes": 20
  },

  "HttpClients": {
    "Resilience": {
      "TimeOutInSeconds": 120
    }
  },

  "Redis": {
    "LocalOverride": false,
    "InstanceName": "SystemUptimeTracker_localhost",
    "Url": "localhost:10120",
    "DefaultCacheDurationMinutes": "120"
  }
}
