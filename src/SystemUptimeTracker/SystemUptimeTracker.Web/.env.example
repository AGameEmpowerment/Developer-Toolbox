# ============================ KEEP THIS STATEMENT ============================
# This file is used to document environment variables for the application.
# See CONTRIBUTING.md for more information on how to use this file.
# =============================================================================

# NOTE1: Make sure your scripts in app settings have a matching port value to these variables.
# NOTE2: For local development this starter uses HTTPS for the API and app URLs.
# NOTE3: If you change ports locally, update the sign-in and sign-out URLs in your identity provider.
# NOTE4: Put real secrets and machine-specific overrides in `.env.local`; keep this file as the documented placeholder template.
# NOTE5: Secret generation guidance for IMPERSONATE_ENCRYPTION_KEY is documented below next to the variable.
# NOTE6: Production/container deployments should provide these values through runtime environment configuration, not by copying this file into the image.

# Base URL for the server API used by the Next.js client.
API_BASE_URL=https://localhost:7060/

# Public app routing configuration.
APP_BASE_URL=https://localhost:3001/
NEXT_PUBLIC_PROFILE_ROUTE=/api/me
NEXT_PUBLIC_ACCESS_TOKEN_ROUTE=auth/token

# Set to true locally only when you explicitly need token values echoed for debugging.
CONSOLE_ACCESSTOKEN=false

# Required in production for local SystemUptimeTracker auth session encryption.
# Generate a high-entropy secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_COOKIE_SECRET=replace_with_high_entropy_secret

# This must match the API impersonation cookie setting if impersonation is enabled.
# Generate impersonation values with `/api/auth/impersonateKeys` or:
# node -e "const crypto=require('node:crypto'); console.log(JSON.stringify({ key: crypto.randomBytes(32).toString('hex') }, null, 2));"
# IMPERSONATE_ENCRYPTION_KEY must be 64 hex chars.
IMPERSONATING_COOKIE=acting-as
NEXT_PUBLIC_IMPERSONATING_COOKIE=${IMPERSONATING_COOKIE}
IMPERSONATE_ENCRYPTION_KEY=replace_with_64_hex_chars

# Local diagnostics and development toggles.
DEV_ENV=false
SHOW_DIAGNOSTICS=true

# Logging configuration shared by the Next.js app and telemetry helpers.
# Valid values: Trace, Debug, Information, Warning, Error, Critical, None
# `.env.local` commonly overrides APP_LOGGING_LEVEL for local troubleshooting.
APP_LOGGING_LEVEL="Information"

# Azure Application Insights connection string.
# Keep the real value in `.env.local`, secure environment configuration, or CI configuration, not in source control.
APP_INSIGHTS_ENABLED=false
APP_INSIGHTS_KEY="secret_for_env_local_file"

# Master switch for OpenTelemetry sinks used by the frontend server runtime.
# When false, Seq, Aspire, and any future OTLP sinks stay disabled.
APP_OPEN_TELEMETRY_ENABLED=false
# Additional sink toggle for local Seq export when the master switch is enabled.
# SEQ Logging should be disabled outside of local machine development, see local Docker Container for log capture.
APP_OPEN_TELEMETRY_SEQ_ENABLED=false
# Additional sink toggle for Aspire OTLP export when the master switch is enabled.
APP_OPEN_TELEMETRY_ASPIRE_ENABLED=false

# Default OpenTelemetry local development target for Seq.
# Replace these on deployment with the environment-specific OTLP endpoint and API key.
APP_OPEN_TELEMETRY_SEQ_ENDPOINT=http://localhost:10150/ingest/otlp/v1/logs
APP_OPEN_TELEMETRY_SEQ_API_KEY=replace_with_seq_api_key

# Optional explicit Aspire OTLP HTTP/protobuf endpoint override.
# When the client is launched by AppHost, Aspire injects OTEL_EXPORTER_OTLP_ENDPOINT at runtime if needed.
APP_OPEN_TELEMETRY_ASPIRE_ENDPOINT=

# Optional standard OTLP variables used when orchestration injects shared collector settings.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=systemuptimetracker-web
OTEL_RESOURCE_ATTRIBUTES=

# Optional Microsoft identity settings for the web companion when Microsoft sign-in is enabled.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_AUTHORITY=
MICROSOFT_API_SCOPE=
MICROSOFT_AUTH_SCOPES=
MICROSOFT_REDIRECT_PATH=/auth/callback
MICROSOFT_POST_LOGOUT_REDIRECT_URI=

# Application metadata attached to telemetry.
# `.env.local` may also override APP_VERSION for local-only builds.
APP_VERSION="0.1.0-local"
APP_NAME="My app"
APP_INSIGHTS_CLOUD_ROLE="my-app-web"
