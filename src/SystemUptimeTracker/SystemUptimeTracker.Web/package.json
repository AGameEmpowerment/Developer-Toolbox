{
  "name": "systemuptimetracker-web",
  "templateVersion": "14.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "node ./scripts/run-next-dev-https.mjs",
    "browser": "start https://localhost:3001",
    "devAndBrowser": "start https://localhost:3001 & npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=verbose --reporter=junit --outputFile.junit=./junit.xml",
    "lint": "eslint .",
    "verify": "npm run lint && npm run test",
    "format": "prettier --write .",
    "upgrade": "npm update",
    "build": "next build",
    "start": "next start",
    "start:prod": "node .next/standalone/server.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@azure/msal-node": "^5.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "applicationinsights": "3.16.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cookies-next": "^6.1.1",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "styled-components": "6.4.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.1.1",
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-onboarding": "10.6.0",
    "@storybook/nextjs": "10.6.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "16.5.0",
    "jest-axe": "10.0.0",
    "jest-extended": "7.0.0",
    "jsdom": "27.3.0",
    "prettier": "3.7.4",
    "storybook": "10.6.0",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "4.1.2"
  }
}
