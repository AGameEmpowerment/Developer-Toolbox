# Public browser-visible label used only as an example. Do not place secrets in
# variables whose names begin with NEXT_PUBLIC_.
NEXT_PUBLIC_APP_NAME=Developer Toolbox Example

# Optional Auth0 middleware; disabled for the public local sample by default.
TOOLBOX_AUTH_ENABLED=false
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_DOMAIN=
APP_BASE_URL=http://localhost:3000
