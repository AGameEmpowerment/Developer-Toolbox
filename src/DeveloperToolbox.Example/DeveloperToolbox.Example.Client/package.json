{
  "name": "developer-toolbox-example-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslint-cache && stylelint \"**/*.css\" --cache --cache-strategy content --cache-location node_modules/.cache/stylelint/.stylelint-cache",
    "format": "prettier --write . --cache --ignore-path .prettierignore",
    "verify": "prettier --check . --ignore-path .prettierignore && npm run lint && npm run test",
    "upgrade": "ncu --interactive --format group --dep=prod,dev,optional,peer --cooldown 1"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.0",
    "negotiator": "^1.0.0",
    "next": "^16.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.3.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.11.1",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "npm-check-updates": "^19.6.6",
    "postcss-styled-syntax": "^0.7.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "vitest": "^4.1.11"
  }
}
