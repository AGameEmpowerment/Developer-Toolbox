{
  "name": "developer-toolbox-example-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "node scripts/apply-braces-depth-guard.mjs --check && next dev",
    "build": "node scripts/apply-braces-depth-guard.mjs --check && next build",
    "start": "node scripts/apply-braces-depth-guard.mjs --check && next start",
    "test": "npm run test:dependency-security && vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "lint": "node scripts/apply-braces-depth-guard.mjs --check && eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslint-cache && stylelint \"**/*.css\" --allow-empty-input --cache --cache-strategy content --cache-location node_modules/.cache/stylelint/.stylelint-cache",
    "format": "node scripts/apply-braces-depth-guard.mjs --check && prettier --write . --cache --ignore-path .prettierignore",
    "verify": "node scripts/apply-braces-depth-guard.mjs --check && prettier --check . --ignore-path .prettierignore && npm run lint && npm run test",
    "upgrade": "node scripts/apply-braces-depth-guard.mjs --check && ncu --interactive --format group --dep=prod,dev,optional,peer --cooldown 1 && npm run format && npm audit fix",
    "postinstall": "node scripts/apply-braces-depth-guard.mjs",
    "test:dependency-security": "node scripts/apply-braces-depth-guard.mjs --check && node --test scripts/tests/braces-depth-guard.test.mjs",
    "build:test": "npm run build"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "negotiator": "^1.1.0",
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "@auth0/nextjs-auth0": "^4.31.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "npm-check-updates": "23.1.1",
    "postcss-styled-syntax": "0.7.3",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "vitest": "5.0.3"
  }
}
