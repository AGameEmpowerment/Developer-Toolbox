    <dependency><groupId>com.azure</groupId><artifactId>azure-data-tables</artifactId><version>12.5.13</version></dependency>
    <dependency><groupId>com.azure</groupId><artifactId>azure-cosmos</artifactId><version>4.83.0</version></dependency>
    <dependency><groupId>software.amazon.awssdk</groupId><artifactId>s3</artifactId></dependency>
