{
  "name": "Com.AGameEmpowerment.DevContainer",

  // SDK major 10 matches the .NET 10 projects; latest could jump to a newer major.
  "image": "mcr.microsoft.com/devcontainers/dotnet:2-10.0",

  // Required for the local-development-only Docker-in-Docker daemon.
  "privileged": true,

  // Match the smallest GitHub Codespaces machine. The optional local emulator stack
  // can require a larger machine when several services run at the same time.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  // Features cover the technologies represented by this developer toolbox. The base
  // image provides the current .NET SDK and git; additional SDKs remain available
  // for reusable samples and migration guidance. More info: https://containers.dev/features.
  "features": {
    // Azure Developer CLI for Azure deployment workflows
    "ghcr.io/azure/azure-dev/azd:latest": {
      "version": "stable"
    },
    // Azure CLI for Azure resource management
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest",
      "installBicep": true
    },
    // AWS CLI for the local SQS, SNS, EventBridge, S3, and Lambda examples
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    },
    // Common utilities including Zsh and Oh My Zsh
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": false,
      "configureZshAsDefaultShell": false
    },
    // Docker-in-Docker runs the Toolbox emulator stack through the repository's delegated launcher
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": true,
      "azureDnsAutoDetection": true,
      "installDockerBuildx": true,
      "installDockerComposeSwitch": true,
      "version": "latest",
      "dockerDashComposeVersion": "latest"
    },
    // Toolbox samples target .NET 10; 8.0 and 9.0 stay for consumer repos that copy this devcontainer.
    // Note: The 'aspire' workload was deprecated; Aspire now uses NuGet packages + CLI
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "none",
      "additionalVersions": "8.0,9.0,10.0",
      "workloads": "wasm-tools"
    },
    // GitHub CLI for repository management
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    // Use the current Node.js LTS for reusable JavaScript tooling.
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts",
      "nodeGypDependencies": true,
      "nvmVersion": "latest"
    },
    // PowerShell for scripting
    "ghcr.io/devcontainers/features/powershell:2": {
      "version": "latest"
    },
    // Git with latest version
    "ghcr.io/devcontainers/features/git:1": {
      "ppa": true,
      "version": "latest"
    },
    // Java 25 is a primary language; Maven builds the SDK and serverless examples.
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installGradle": false,
      "installMaven": true
    },
    // Terraform for infrastructure as code
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "latest"
    },
    // Python 3.14 is a primary language and matches the serverless samples.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "installTools": true
    }
  },

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[csharp]": {
          "editor.defaultFormatter": "ms-dotnettools.csharp"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[powershell]": {
          "editor.defaultFormatter": "ms-vscode.powershell"
        },
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "eslint.workingDirectories": [{ "mode": "auto" }],
        "npm.packageManager": "npm"
      },
      // Required extensions installed in the dev container.
      "extensions": [
        "AmazonWebServices.aws-toolkit-vscode",
        "Anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-vscode.powershell",
        "openai.chatgpt",
        "sonarsource.sonarlint-vscode"
      ]
    }
  },

  // Prepare the toolchain after the container is created. The hook intentionally does
  // not restore credentialed packages or start the local emulator stack.
  "postCreateCommand": "pwsh -File ${containerWorkspaceFolder}/.devcontainer/post_devcontainer.ps1",

  // Port 3000 is the conventional Next.js development port used by the sample
  // client. The remaining ports mirror the host bindings from
  // <toolbox>/containers/docker-compose-common.yml, docker-compose-azure.yml,
  // and docker-compose-aws.yml in the external Developer-Toolbox checkout.
  // Those Compose files are the source of truth; these entries make their local-development-
  // only emulator endpoints available through the consuming devcontainer.
  "forwardPorts": [
    3000, // Next.js sample client
    5672, // Azure Functions Service Bus trigger (standard emulator AMQP port)
    7071, // Azure Functions sample
    7072, // Java Azure Functions
    7073, // Node.js Azure Functions
    7074, // Python Azure Functions
    10000, // Azurite Blob
    10001, // Azurite Queue
    10002, // Azurite Table
    10080, // WireMock HTTP
    10081, // Cosmos DB emulator
    10120, // Redis
    10121, // RedisInsight
    10130, // smtp4dev SMTP
    10131, // smtp4dev POP3
    10132, // smtp4dev IMAP
    10140, // smtp4dev web UI
    10150, // Seq
    10170, // Service Bus AMQP
    10171, // Service Bus management
    10180, // DynamoDB Local
    10181, // Cosmos DB Data Explorer
    10190, // RabbitMQ AMQP
    10191, // RabbitMQ management
    10195, // Moto AWS emulator SQS/SNS/EventBridge/S3
    10432, // PostgreSQL
    10433, // SQL Server
    10443 // WireMock HTTPS
  ],

  "portsAttributes": {
    "3000": {
      "label": "Next.js sample client",
      "protocol": "http"
    },
    "7071": {
      "label": "Azure Functions sample",
      "protocol": "http"
    },
    "10080": {
      "label": "WireMock HTTP",
      "protocol": "http"
    },
    "10081": {
      "label": "Cosmos DB emulator",
      "protocol": "https"
    },
    "10121": {
      "label": "RedisInsight",
      "protocol": "http"
    },
    "10140": {
      "label": "smtp4dev",
      "protocol": "http"
    },
    "10150": {
      "label": "Seq",
      "protocol": "http"
    },
    "10180": {
      "label": "DynamoDB Local",
      "protocol": "http"
    },
    "10181": {
      "label": "Cosmos DB Data Explorer",
      "protocol": "https"
    },
    "10191": {
      "label": "RabbitMQ management",
      "protocol": "http"
    },
    "10195": {
      "label": "Moto AWS gateway",
      "protocol": "http"
    },
    "10432": {
      "label": "PostgreSQL"
    },
    "10443": {
      "label": "WireMock HTTPS",
      "protocol": "https"
    }
  },

  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },

  "containerEnv": {
    "DEVCONTAINER": "true",
    "ASPNETCORE_ENVIRONMENT": "Development",
    "DOTNET_ENVIRONMENT": "Development",
    "ASPNETCORE_LOCALDEV": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NUGET_XMLDOC_MODE": "skip",
    "NODE_ENV": "development"
  },

  // Workspace is automatically mounted by VS Code to /workspaces/<project-name>
  // No explicit mount needed - VS Code handles this with --workspace-mount-consistency cached

  // Run as non-root user for security
  "remoteUser": "vscode"
}
